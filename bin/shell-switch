#!/usr/bin/env bash
# ==============================================================================
# Desktop Shell & Rice Switcher (shell-switch)
# Easily switch between Caelestia, 43PR, 44 Dots, and custom desktop rices
# ==============================================================================

set -euo pipefail

PROFILES_DIR="${HOME}/.config/desktop-shells"
CURRENT_FILE="${PROFILES_DIR}/current"

# Ensure profiles directory exists
mkdir -p "${PROFILES_DIR}"

# Helper colors for terminal output
BOLD="\033[1m"
GREEN="\033[1;32m"
CYAN="\033[1;36m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
MUTED="\033[0;90m"
RESET="\033[0m"

get_current() {
    if [[ -f "${CURRENT_FILE}" ]]; then
        cat "${CURRENT_FILE}" 2>/dev/null || echo "caelestia"
    else
        echo "caelestia"
    fi
}

notify_user() {
    local title="$1"
    local message="$2"
    local icon="${3:-preferences-desktop-theme}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i "${icon}" -u normal "${title}" "${message}" >/dev/null 2>&1 &
    fi

    if [[ -f /usr/share/sounds/freedesktop/stereo/complete.oga ]] && command -v pw-play >/dev/null 2>&1; then
        pw-play /usr/share/sounds/freedesktop/stereo/complete.oga >/dev/null 2>&1 &
    fi
}

cmd_current() {
    local cur
    cur="$(get_current)"
    printf "${BOLD}Current Shell:${RESET} ${GREEN}%s${RESET}\n" "${cur}"
}

cmd_list() {
    local cur
    cur="$(get_current)"
    printf "\n${BOLD}Available Desktop Shells & Rices:${RESET}\n\n"

    for pdir in "${PROFILES_DIR}"/*; do
        [[ -d "${pdir}" ]] || continue
        local id
        id="$(basename "${pdir}")"
        local pfile="${pdir}/profile.sh"

        local name="${id}"
        local desc="No description"
        local icon="preferences-desktop-theme"

        if [[ -f "${pfile}" ]]; then
            # Source in a subshell to avoid polluting environment
            eval "$(
                (
                    PROFILE_DIR="${pdir}"
                    source "${pfile}" 2>/dev/null || true
                    printf 'name=%q; desc=%q; icon=%q' "${NAME:-${id}}" "${DESCRIPTION:-No description}" "${ICON:-preferences-desktop-theme}"
                )
            )"
        fi

        if [[ "${id}" == "${cur}" ]]; then
            printf "  ${GREEN}● %-12s${RESET} ${BOLD}%s${RESET} ${CYAN}[ACTIVE]${RESET}\n" "${id}" "${name}"
            printf "    ${MUTED}%s${RESET}\n\n" "${desc}"
        else
            printf "    %-12s ${BOLD}%s${RESET}\n" "${id}" "${name}"
            printf "    ${MUTED}%s${RESET}\n\n" "${desc}"
        fi
    done
}

cmd_switch() {
    local target="${1:-}"
    local force="${2:-false}"

    if [[ -z "${target}" ]]; then
        printf "${RED}Error:${RESET} No shell profile specified.\n"
        printf "Run ${BOLD}shell-switch list${RESET} to see available options.\n"
        exit 1
    fi

    local target_dir="${PROFILES_DIR}/${target}"
    local target_profile="${target_dir}/profile.sh"

    if [[ ! -d "${target_dir}" || ! -f "${target_profile}" ]]; then
        printf "${RED}Error:${RESET} Profile '%s' not found in %s\n" "${target}" "${PROFILES_DIR}"
        cmd_list
        exit 1
    fi

    local current
    current="$(get_current)"

    if [[ "${target}" == "${current}" && "${force}" != "true" && "${force}" != "--force" ]]; then
        printf "${YELLOW}Notice:${RESET} '%s' is already the active desktop shell.\n" "${target}"
        printf "Use ${BOLD}shell-switch %s --force${RESET} to reload it anyway.\n" "${target}"
        return 0
    fi

    printf "${CYAN}→ Switching desktop shell from %s to %s...${RESET}\n" "${current}" "${target}"

    # 1. Stop current shell if profile exists
    local cur_profile="${PROFILES_DIR}/${current}/profile.sh"
    if [[ -f "${cur_profile}" ]]; then
        (
            PROFILE_DIR="${PROFILES_DIR}/${current}"
            source "${cur_profile}" 2>/dev/null || true
            if declare -f stop_shell >/dev/null; then
                stop_shell || true
            fi
        )
    fi

    # Extra safety: kill any remaining quickshell / waybar
    pkill -f "qs -c caelestia" 2>/dev/null || true
    pkill -x qs 2>/dev/null || true

    # 2. Source target profile to get configs and lifecycle hooks
    export PROFILE_DIR="${target_dir}"
    source "${target_profile}"

    # 3. Swap symlinks for defined configs
    if declare -p CONFIG_MAP >/dev/null 2>&1; then
        for cfg_name in "${!CONFIG_MAP[@]}"; do
            local src_path="${CONFIG_MAP[${cfg_name}]}"
            local dest_path="${HOME}/.config/${cfg_name}"

            if [[ -e "${src_path}" ]]; then
                # Safety check: if destination is a real directory (not a symlink), preserve it in 'original' profile
                if [[ -d "${dest_path}" && ! -L "${dest_path}" ]]; then
                    local backup_dir="${PROFILES_DIR}/original/${cfg_name}"
                    printf "  ${YELLOW}Preserving existing real ~/.config/%s into %s${RESET}\n" "${cfg_name}" "${backup_dir}"
                    mkdir -p "${PROFILES_DIR}/original"
                    cp -a "${dest_path}" "${backup_dir}"
                    rm -rf "${dest_path}"

                    if [[ ! -f "${PROFILES_DIR}/original/profile.sh" ]]; then
                        cat << 'BAKEOF' > "${PROFILES_DIR}/original/profile.sh"
#!/usr/bin/env bash
NAME="Original Setup"
DESCRIPTION="Automatic backup of your pre-existing desktop configuration"
ICON="user-home"

declare -A CONFIG_MAP=(
    ["hypr"]="$PROFILE_DIR/hypr"
    ["waybar"]="$PROFILE_DIR/waybar"
    ["quickshell"]="$PROFILE_DIR/quickshell"
)

start_shell() {
    pkill -x qs 2>/dev/null || true
    pkill -f "qs -c caelestia" 2>/dev/null || true
    pkill -x waybar 2>/dev/null || true
    sleep 0.3
    if [[ -f "$PROFILE_DIR/waybar/config" ]] && command -v waybar >/dev/null 2>&1; then
        setsid waybar >/dev/null 2>&1 &
    elif [[ -d "$PROFILE_DIR/quickshell" ]] && command -v qs >/dev/null 2>&1; then
        setsid qs >/dev/null 2>&1 &
    fi
}

stop_shell() {
    pkill -x waybar 2>/dev/null || true
    pkill -x qs 2>/dev/null || true
    pkill -f "qs -c caelestia" 2>/dev/null || true
}
BAKEOF
                        chmod +x "${PROFILES_DIR}/original/profile.sh"
                    fi
                else
                    rm -rf "${dest_path}"
                fi

                printf "  Linking ~/.config/%s -> %s\n" "${cfg_name}" "${src_path}"
                ln -sfn "${src_path}" "${dest_path}"
            else
                printf "${YELLOW}  Warning: Config path '%s' does not exist, skipping ~/.config/%s${RESET}\n" "${src_path}" "${cfg_name}"
            fi
        done
    fi

    # 4. Reload Hyprland configuration
    if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        printf "  Reloading Hyprland...\n"
        hyprctl reload >/dev/null 2>&1 || true
        sleep 0.8
    fi

    # 5. Start the new shell
    printf "  Starting new desktop shell...\n"
    if declare -f start_shell >/dev/null; then
        start_shell || true
    fi
    disown -a 2>/dev/null || true

    # 6. Update current shell marker
    echo "${target}" > "${CURRENT_FILE}"

    local display_name="${NAME:-${target}}"
    printf "${GREEN}✔ Successfully switched to %s!${RESET}\n" "${display_name}"
    notify_user "Desktop Shell Switched" "Active shell is now: ${display_name}" "${ICON:-preferences-desktop-theme}"
}

cmd_gui() {
    local gui_app="${HOME}/.local/bin/desktop-shell-app.py"
    if [[ -x "${gui_app}" ]] && [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
        exec "${gui_app}" "$@"
    else
        cmd_menu
    fi
}

cmd_menu() {
    local cur
    cur="$(get_current)"
    local menu_items=""

    for pdir in "${PROFILES_DIR}"/*; do
        [[ -d "${pdir}" ]] || continue
        local id
        id="$(basename "${pdir}")"
        local pfile="${pdir}/profile.sh"

        local name="${id}"
        local desc=""

        if [[ -f "${pfile}" ]]; then
            eval "$(
                (
                    PROFILE_DIR="${pdir}"
                    source "${pfile}" 2>/dev/null || true
                    printf 'name=%q; desc=%q' "${NAME:-${id}}" "${DESCRIPTION:-}"
                )
            )"
        fi

        if [[ "${id}" == "${cur}" ]]; then
            menu_items+="${id}  |  ${name} [ACTIVE]  |  ${desc}"$'\n'
        else
            menu_items+="${id}  |  ${name}  |  ${desc}"$'\n'
        fi
    done

    menu_items+="[+] Clone from GitHub..."$'\n'

    local selected=""
    if command -v rofi >/dev/null 2>&1; then
        selected="$(echo -n "${menu_items}" | rofi -dmenu -i -p "Switch Shell" -lines 8 || true)"
    elif command -v fuzzel >/dev/null 2>&1; then
        selected="$(echo -n "${menu_items}" | fuzzel --dmenu --prompt "Switch Shell: " || true)"
    elif command -v yad >/dev/null 2>&1; then
        selected="$(echo -n "${menu_items}" | yad --list --column="Shells" --width=500 --height=350 --title="Desktop Shell Switcher" || true)"
    fi

    if [[ -z "${selected}" ]]; then
        return 0
    fi

    if [[ "${selected}" == "[+]"* ]]; then
        cmd_gui_clone
        return 0
    fi

    local target_id
    target_id="$(echo "${selected}" | awk '{print $1}')"

    if [[ -n "${target_id}" ]]; then
        cmd_switch "${target_id}"
    fi
}

cmd_gui_clone() {
    local url=""
    if command -v yad >/dev/null 2>&1; then
        url="$(yad --entry --title="Clone Dotfiles / Shell" --text="Enter GitHub Repository URL:" --width=450 || true)"
    elif command -v rofi >/dev/null 2>&1; then
        url="$(rofi -dmenu -p "Git URL" || true)"
    fi

    if [[ -n "${url}" ]]; then
        local name
        name="$(basename "${url}" .git)"
        cmd_clone "${url}" "${name}"
        cmd_gui
    fi
}

cmd_add() {
    local name="${1:-}"
    if [[ -z "${name}" ]]; then
        printf "${RED}Error:${RESET} Please specify a name for the new profile.\n"
        printf "Usage: ${BOLD}shell-switch add <profile_name>${RESET}\n"
        exit 1
    fi

    local pdir="${PROFILES_DIR}/${name}"
    if [[ -d "${pdir}" ]]; then
        printf "${YELLOW}Profile '%s' already exists at %s${RESET}\n" "${name}" "${pdir}"
        return 0
    fi

    mkdir -p "${pdir}"
    cat << EOF > "${pdir}/profile.sh"
#!/usr/bin/env bash
NAME="${name}"
DESCRIPTION="Custom desktop shell setup"
ICON="preferences-desktop-theme"

# Map of symlinks to place into ~/.config/ when this shell is active
declare -A CONFIG_MAP=(
    ["hypr"]="\${PROFILE_DIR}/hypr"
    # ["quickshell"]="\${PROFILE_DIR}/quickshell"
    # ["waybar"]="\${PROFILE_DIR}/waybar"
)

start_shell() {
    # Command to start your desktop shell / bar
    # Example: waybar &
    true
}

stop_shell() {
    # Command to stop your desktop shell / bar
    # Example: pkill -x waybar || true
    true
}
EOF
    chmod +x "${pdir}/profile.sh"
    printf "${GREEN}✔ Created new shell profile template at:${RESET} %s\n" "${pdir}/profile.sh"
    printf "Edit ${BOLD}%s/profile.sh${RESET} to configure your shell.\n" "${pdir}"
}

cmd_clone() {
    local url="${1:-}"
    local name="${2:-}"

    if [[ -z "${url}" ]]; then
        printf "${RED}Error:${RESET} Please provide a git repository URL.\n"
        printf "Usage: ${BOLD}shell-switch clone <git-url> [profile_name]${RESET}\n"
        exit 1
    fi

    if [[ -z "${name}" ]]; then
        name="$(basename "${url}" .git)"
    fi

    local pdir="${PROFILES_DIR}/${name}"
    if [[ -d "${pdir}" ]]; then
        printf "${YELLOW}Profile '%s' already exists at %s${RESET}\n" "${name}" "${pdir}"
        return 0
    fi

    printf "${CYAN}→ Cloning %s into %s...${RESET}\n" "${url}" "${pdir}/repo"
    mkdir -p "${pdir}"
    git clone --depth 1 "${url}" "${pdir}/repo"

    cat << EOF > "${pdir}/profile.sh"
#!/usr/bin/env bash
NAME="${name}"
DESCRIPTION="Cloned from ${url}"
ICON="view-app-grid"

declare -A CONFIG_MAP=()

# Auto-detect common dotfile directories
if [[ -d "\${PROFILE_DIR}/repo/hypr" ]]; then
    CONFIG_MAP["hypr"]="\${PROFILE_DIR}/repo/hypr"
elif [[ -d "\${PROFILE_DIR}/repo/.config/hypr" ]]; then
    CONFIG_MAP["hypr"]="\${PROFILE_DIR}/repo/.config/hypr"
fi

if [[ -d "\${PROFILE_DIR}/repo/waybar" ]]; then
    CONFIG_MAP["waybar"]="\${PROFILE_DIR}/repo/waybar"
elif [[ -d "\${PROFILE_DIR}/repo/.config/waybar" ]]; then
    CONFIG_MAP["waybar"]="\${PROFILE_DIR}/repo/.config/waybar"
fi

if [[ -d "\${PROFILE_DIR}/repo/quickshell" ]]; then
    CONFIG_MAP["quickshell"]="\${PROFILE_DIR}/repo/quickshell"
elif [[ -d "\${PROFILE_DIR}/repo/.config/quickshell" ]]; then
    CONFIG_MAP["quickshell"]="\${PROFILE_DIR}/repo/.config/quickshell"
fi

start_shell() {
    pkill -x qs 2>/dev/null || true
    pkill -f "qs -c caelestia" 2>/dev/null || true
    pkill -x waybar 2>/dev/null || true

    if [[ -n "\${CONFIG_MAP[waybar]:-}" ]] && command -v waybar >/dev/null 2>&1; then
        waybar >/dev/null 2>&1 &
    elif [[ -n "\${CONFIG_MAP[quickshell]:-}" ]] && command -v qs >/dev/null 2>&1; then
        qs >/dev/null 2>&1 &
    fi
}

stop_shell() {
    pkill -x waybar 2>/dev/null || true
    pkill -x qs 2>/dev/null || true
}
EOF
    chmod +x "${pdir}/profile.sh"
    printf "${GREEN}✔ Profile '%s' configured successfully!${RESET}\n" "${name}"
    printf "Switch to it anytime with: ${BOLD}shell-switch %s${RESET}\n" "${name}"
}

cmd_backup() {
    local name="${1:-backup-$(date +%Y%m%d-%H%M%S)}"
    local pdir="${PROFILES_DIR}/${name}"

    if [[ -d "${pdir}" ]]; then
        printf "${RED}Error:${RESET} Profile '%s' already exists.\n" "${name}"
        exit 1
    fi

    printf "${CYAN}→ Snapshotting active desktop configs into profile '%s'...${RESET}\n" "${name}"
    mkdir -p "${pdir}"

    local configs_copied=()
    for cfg in hypr waybar quickshell swaync rofi fuzzel dms; do
        if [[ -d "${HOME}/.config/${cfg}" ]]; then
            cp -aL "${HOME}/.config/${cfg}" "${pdir}/${cfg}" 2>/dev/null || cp -a "${HOME}/.config/${cfg}" "${pdir}/${cfg}" 2>/dev/null || true
            configs_copied+=("${cfg}")
        fi
    done

    cat << EOF > "${pdir}/profile.sh"
#!/usr/bin/env bash
NAME="${name}"
DESCRIPTION="Snapshot created on $(date '+%Y-%m-%d %H:%M:%S')"
ICON="document-save"

declare -A CONFIG_MAP=(
EOF

    for cfg in "${configs_copied[@]}"; do
        echo "    [\"${cfg}\"]=\"\${PROFILE_DIR}/${cfg}\"" >> "${pdir}/profile.sh"
    done

    cat << 'EOF' >> "${pdir}/profile.sh"
)

start_shell() {
    pkill -x qs 2>/dev/null || true
    pkill -f "qs -c caelestia" 2>/dev/null || true
    pkill -x waybar 2>/dev/null || true
    pkill -x swaync 2>/dev/null || true
    sleep 0.3
    if [[ -d "${CONFIG_MAP[quickshell]:-}" ]] && command -v qs >/dev/null 2>&1; then
        setsid qs >/dev/null 2>&1 &
    elif [[ -f "${CONFIG_MAP[waybar]:-}/config" ]] && command -v waybar >/dev/null 2>&1; then
        setsid waybar >/dev/null 2>&1 &
    fi
}

stop_shell() {
    pkill -x waybar 2>/dev/null || true
    pkill -x qs 2>/dev/null || true
    pkill -x swaync 2>/dev/null || true
}
EOF
    chmod +x "${pdir}/profile.sh"
    printf "${GREEN}✔ Created snapshot profile at %s${RESET}\n" "${pdir}"
    printf "Switch to it anytime with: ${BOLD}shell-switch %s${RESET}\n" "${name}"
}

cmd_get() {
    local rice="${1:-}"

    declare -A CATALOG_URLS=(
        ["hyde"]="https://github.com/HyDE-Project/HyDE"
        ["dms"]="https://github.com/AvengeMedia/DankMaterialShell"
        ["end4"]="https://github.com/end-4/dots-hyprland"
        ["ml4w"]="https://github.com/mylinuxforwork/dotfiles"
        ["44dots"]="https://github.com/44kash/dotfiles"
        ["caelestia"]="https://github.com/caelestia-dots/caelestia"
    )

    declare -A CATALOG_NAMES=(
        ["hyde"]="HyDE Rice"
        ["dms"]="DankMaterialShell"
        ["end4"]="end-4 Dots (illogical-impulse)"
        ["ml4w"]="ML4W Dotfiles"
        ["44dots"]="44 Dots"
        ["caelestia"]="Caelestia Shell"
    )

    declare -A CATALOG_DESC=(
        ["hyde"]="Modular HyDE Hyprland rice with Waybar, dynamic themes, Rofi & SwayNC"
        ["dms"]="Material 3 Quickshell desktop shell with dynamic theming & dock"
        ["end4"]="Material You desktop rice with Quickshell 'ii' suite, Matugen & Fuzzel"
        ["ml4w"]="MyLinuxForWork modular Hyprland desktop with Waybar themes & Rofi"
        ["44dots"]="Clean Arch Linux & Hyprland rice with Waybar, SwayNC & Rofi"
        ["caelestia"]="Quickshell desktop shell with dynamic colors, drawers & widgets"
    )

    if [[ -z "${rice}" ]]; then
        printf "\n${BOLD}Popular Desktop Shells & Rice Catalog:${RESET}\n\n"
        printf "  %-12s %-25s %s\n" "ID" "NAME" "STATUS"
        printf "  %-12s %-25s %s\n" "──" "────" "──────"

        for id in "caelestia" "hyde" "dms" "end4" "ml4w" "44dots"; do
            local status="${MUTED}[Available]${RESET}"
            if [[ -d "${PROFILES_DIR}/${id}" ]]; then
                if [[ "$(get_current)" == "${id}" ]]; then
                    status="${GREEN}[Active]${RESET}"
                else
                    status="${CYAN}[Installed]${RESET}"
                fi
            fi
            printf "  ${BOLD}%-12s${RESET} %-25s %b\n" "${id}" "${CATALOG_NAMES[${id}]}" "${status}"
            printf "               ${MUTED}%s${RESET}\n" "${CATALOG_DESC[${id}]}"
            printf "               ${MUTED}Repo: %s${RESET}\n\n" "${CATALOG_URLS[${id}]}"
        done

        printf "Install any rice setup with: ${GREEN}shell-switch get <id>${RESET}\n\n"
        return 0
    fi

    if [[ -z "${CATALOG_URLS[${rice}]:-}" ]]; then
        printf "${RED}Error:${RESET} Unknown rice '%s'. Run ${BOLD}shell-switch get${RESET} to view catalog.\n" "${rice}"
        exit 1
    fi

    local pdir="${PROFILES_DIR}/${rice}"
    if [[ -d "${pdir}" ]]; then
        printf "${YELLOW}Notice:${RESET} Profile '%s' is already installed at %s\n" "${rice}" "${pdir}"
        printf "Switch to it with: ${BOLD}shell-switch %s${RESET}\n" "${rice}"
        return 0
    fi

    local url="${CATALOG_URLS[${rice}]}"
    printf "${CYAN}→ Installing %s (%s)...${RESET}\n" "${CATALOG_NAMES[${rice}]}" "${url}"

    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd || echo "")"
    local packaged_profile="${script_dir}/example-profiles/${rice}/profile.sh"

    mkdir -p "${pdir}"
    printf "  Cloning repository (shallow)...\n"
    git clone --depth 1 "${url}" "${pdir}/repo"

    if [[ -f "${packaged_profile}" ]]; then
        cp -f "${packaged_profile}" "${pdir}/profile.sh"
    elif [[ -f "${HOME}/.config/desktop-shells/${rice}/profile.sh" ]]; then
        cp -f "${HOME}/.config/desktop-shells/${rice}/profile.sh" "${pdir}/profile.sh"
    else
        cmd_clone "${url}" "${rice}"
    fi

    chmod +x "${pdir}/profile.sh"
    printf "${GREEN}✔ Successfully installed %s!${RESET}\n" "${CATALOG_NAMES[${rice}]}"
    printf "\nTo switch to this rice now, run:\n"
    printf "  ${BOLD}${GREEN}shell-switch %s${RESET}\n\n" "${rice}"
}

cmd_remove() {
    local target="${1:-}"
    if [[ -z "${target}" ]]; then
        printf "${RED}Error:${RESET} Please specify a profile name to remove.\n"
        printf "Usage: ${BOLD}shell-switch remove <name>${RESET}\n"
        exit 1
    fi

    if [[ "${target}" == "$(get_current)" ]]; then
        printf "${RED}Error:${RESET} Cannot remove currently active profile '%s'. Switch to another profile first.\n" "${target}"
        exit 1
    fi

    local pdir="${PROFILES_DIR}/${target}"
    if [[ ! -d "${pdir}" ]]; then
        printf "${RED}Error:${RESET} Profile '%s' not found.\n" "${target}"
        exit 1
    fi

    rm -rf "${pdir}"
    printf "${GREEN}✔ Removed profile '%s'.${RESET}\n" "${target}"
}

cmd_help() {
    printf "\n${BOLD}Desktop Shell Switcher (${CYAN}shell-switch${RESET}${BOLD})${RESET}\n"
    printf "Instantly switch between Caelestia, 43PR, 44 Dots, and other desktop rices.\n\n"
    printf "Usage:\n"
    printf "  ${GREEN}shell-switch${RESET}                     Open interactive GUI switcher (Libadwaita/Rofi)\n"
    printf "  ${GREEN}shell-switch <name>${RESET}              Switch immediately to a shell profile\n"
    printf "  ${GREEN}shell-switch list${RESET} (or ${GREEN}ls${RESET})        List all available shell profiles\n"
    printf "  ${GREEN}shell-switch current${RESET}             Show the currently active shell\n"
    printf "  ${GREEN}shell-switch get [rice_id]${RESET}       Explore or 1-click install popular rices\n"
    printf "  ${GREEN}shell-switch backup [name]${RESET}       Snapshot active desktop configuration\n"
    printf "  ${GREEN}shell-switch clone <url> [name]${RESET}  Clone a GitHub dotfiles repo as a shell\n"
    printf "  ${GREEN}shell-switch add <name>${RESET}          Create a new shell profile template\n"
    printf "  ${GREEN}shell-switch remove <name>${RESET}       Remove an installed shell profile\n"
    printf "  ${GREEN}shell-switch help${RESET}                Show this help message\n\n"
}

# Main routing
ACTION="${1:-}"

case "${ACTION}" in
    gui|app|ui)
        cmd_gui
        ;;
    menu|rofi|popup)
        cmd_menu
        ;;
    "")
        if [[ -t 0 && -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
            cmd_list
        else
            cmd_gui
        fi
        ;;
    list|ls)
        cmd_list
        ;;
    current)
        cmd_current
        ;;
    get)
        cmd_get "${2:-}"
        ;;
    backup)
        cmd_backup "${2:-}"
        ;;
    add)
        cmd_add "${2:-}"
        ;;
    remove|rm|delete)
        cmd_remove "${2:-}"
        ;;
    clone)
        cmd_clone "${2:-}" "${3:-}"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        cmd_switch "${ACTION}" "${2:-false}"
        ;;
esac
