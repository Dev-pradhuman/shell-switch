#compdef shell-switch rice

_shell_switch() {
    local -a commands rices profiles

    commands=(
        'list:List all available desktop shell profiles'
        'ls:List all available desktop shell profiles'
        'current:Show currently active shell and keybinds'
        'keybinds:View or switch active Hyprland keybinds profile'
        'default:View or set default shell & keybinds'
        'set-default:Set default shell & keybinds'
        'launcher:Launch active desktop native app launcher'
        'sidebar:Toggle active desktop native notification sidebar'
        'custom:Open user overlay rules (~/.config/desktop-shells/user-custom.conf)'
        'doctor:Run diagnostic health check on environment or profile'
        'wallpaper:Set and persist wallpaper across active and future shells'
        'theme:Set or toggle global GTK/Matugen/shell color mode'
        'export:Export active or named shell profile to tar.gz bundle'
        'get:Download and install a popular desktop rice'
        'backup:Create a snapshot of current desktop configuration'
        'clone:Clone a GitHub dotfiles repository as a shell profile'
        'add:Create a new shell profile template'
        'remove:Delete an installed shell profile'
        'rm:Delete an installed shell profile'
        'gui:Launch native Libadwaita desktop switcher'
        'menu:Open fast rofi/fuzzel quick picker'
        'help:Show help message'
    )

    rices=(
        'caelestia:Quickshell desktop shell with dynamic colors & drawers'
        'hyde:HyDE Project modular desktop with Waybar & dynamic themes'
        'dms:Material 3 Quickshell desktop shell with dock'
        'end4:end-4 Material You desktop with Quickshell ii suite'
        'end4-pc:Material 3 Expressive desktop fork with presets gallery'
        'ml4w:MyLinuxForWork modular Hyprland desktop with Waybar & Rofi'
        '44dots:Arch Linux & Hyprland rice with Waybar & SwayNC'
    )

    local profiles_dir="${HOME}/.config/desktop-shells"
    if [[ -d "${profiles_dir}" ]]; then
        for p in "${profiles_dir}"/*(/N); do
            local pname="${p:t}"
            profiles+=("${pname}:${pname} shell profile")
        done
    fi

    _arguments -C \
        '1: :->command_or_profile' \
        '2: :->argument' \
        && return 0

    case "$state" in
        command_or_profile)
            _describe -t commands 'command' commands
            _describe -t profiles 'installed shell profile' profiles
            ;;
        argument)
            case "$words[2]" in
                keybinds|binds|keys)
                    _describe -t profiles 'keybinds profile' profiles
                    ;;
                default|set-default)
                    _describe -t profiles 'default shell' profiles
                    ;;
                doctor|check|diagnose)
                    _describe -t profiles 'profile to diagnose' profiles
                    ;;
                theme)
                    local -a themes
                    themes=('dark:Switch to dark theme' 'light:Switch to light theme' 'toggle:Toggle between dark and light')
                    _describe -t themes 'theme mode' themes
                    ;;
                export|bundle)
                    _describe -t profiles 'profile to export' profiles
                    ;;
                wallpaper|wall|bg)
                    _files -g "*.{png,jpg,jpeg,webp}"
                    ;;
                custom)
                    ;;
                get)
                    _describe -t rices 'available rice' rices
                    ;;
                remove|rm|delete)
                    _describe -t profiles 'profile to remove' profiles
                    ;;
                *)
                    _describe -t profiles 'keybinds profile' profiles
                    ;;
            esac
            ;;
    esac
}

_shell_switch "$@"
